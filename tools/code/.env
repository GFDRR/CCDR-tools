# Environment variables for the CCDR Hazard analysis notebooks

# Location of data files
# Use absolute paths, and keep the trailing slash
DATA_DIR = X:/Work/WB/Risk_tools/script/data

# Location to store downloaded rasters and other data
# for the analysis notebooks
CACHE_DIR = ${DATA_DIR}/cache
OUTPUT_DIR = ${DATA_DIR}/RSK

# Only set this to true if your network breaks default TLS certificate
# verification for the tool's outbound HTTPS requests (WorldPop, the WB
# ArcGIS boundary service, the STAC search API) - e.g. a corporate proxy
# that intercepts/re-signs TLS. Leave unset/false otherwise: this disables
# certificate verification for every HTTPS request made by the whole
# process for the rest of the session, not just this tool's own calls.
# DISABLE_SSL_VERIFICATION = true